{
  "name": "toni",
  "productName": "Toni",
  "version": "1.0.0",
  "description": "Toni the Rigatoni reminds you to sit up straight every 20 minutes.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "test:smoke": "node tools/smoke-test.js",
    "check": "node --check main.js && node --check preload.js && node --check src/app.js && node --check src/card.js && node --check src/toni.js",
    "package": "electron-packager . Toni --platform=win32 --arch=x64 --icon=assets/toni.ico --out=dist --overwrite --ignore=^/dist --ignore=^/tools --ignore=^/test --asar",
    "package:mac": "electron-packager . Toni --platform=darwin --arch=arm64,x64 --icon=assets/toni.icns --app-bundle-id=com.toni.rigatoni --out=dist --overwrite --ignore=^/dist --ignore=^/tools --ignore=^/test --asar"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.0.0"
  }
}
